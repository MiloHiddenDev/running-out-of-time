local ReplicatedStorage = game:GetService("ReplicatedStorage")
local event = ReplicatedStorage:WaitForChild("GlobalMessageEvent")

event.OnClientEvent:Connect(function(sender, message)
	local player = game.Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	local screen = Instance.new("ScreenGui")
	screen.IgnoreGuiInset = true
	screen.ResetOnSpawn = false
	screen.Parent = playerGui

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 50)
	label.Position = UDim2.new(0, 0, 0, 20)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.5
	label.TextSize = 32
	label.Font = Enum.Font.GothamBold
	label.Text = sender .. ": " .. message
	label.Parent = screen

	game:GetService("TweenService"):Create(label, TweenInfo.new(0.5), {TextTransparency = 0}):Play()
	task.wait(7)
	game:GetService("TweenService"):Create(label, TweenInfo.new(1), {TextTransparency = 1}):Play()
	task.wait(1)
	screen:Destroy()
end)
